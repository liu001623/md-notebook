c-tips tr:last-child td { border-bottom: none; }\n.mc-ft { text-align: center; margin-top: 20px; padding-top: 12px; border-top: 1px solid #eee; color: #aaa; font-size: 11px; }\nmjx-container { font-size: 105% !important; }\n</style>\n\n<div class=\"mc-result\">\n\n<h1>每日一练（第四天）批改与详解</h1>\n<p class=\"mc-subtitle\">有理数混合运算 | 2026-07-17</p>\n\n<div class=\"mc-summary\">\n  <span>总题数：<b>10</b></span>\n  <span>正确：<b>1</b></span>\n  <span>错误：<b>8</b></span>\n  <span>未作答：<b>1</b></span>\n  <span>得分：<b style=\"font-size:20px;color:#c0392b;\">10/100</b></span>\n</div>\n\n<hr>\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (1) 题</span>\n    <span class=\"mc-badge mc-berr\">错误</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"-1 - 8 \\div (-4) \\times |-6 \\div 4|\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-err\">学生答案：未完成</div>\n    <div class=\"mc-en\">错因：\\(|-6 \\div 4|\\) 应为 \\(\\dfrac{3}{2}\\)，非 2</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 - 8 \\div (-4) \\times \\dfrac{3}{2}\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 - 2 \\times \\dfrac{3}{2}\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 - 3\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"\\boxed{-4}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (2) 题</span>\n    <span class=\"mc-badge mc-berr\">错误</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"-1^{2022} + 14 \\div \\left[ 1 - \\left( \\dfrac{3}{4} \\right)^2 \\right] - |-5|\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-err\">学生答案：28</div>\n    <div class=\"mc-en\">错因：\\(-1+32-5\\) 误算为 28，正确为 26</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 + 14 \\div \\left[ 1 - \\dfrac{9}{16} \\right] - 5\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 + 14 \\div \\dfrac{7}{16} - 5\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 + 32 - 5\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"= 31 - 5 = \\boxed{26}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-na\">\n    <span>第 (3) 题</span>\n    <span class=\"mc-badge mc-bna\">未作答</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"-99\\dfrac{35}{36} \\times 18\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-na\">学生答案：未作答</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -\\left(99 + \\dfrac{35}{36}\\right) \\times 18\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -(99 \\times 18 + \\dfrac{35}{36} \\times 18)\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -(1782 + 17\\dfrac{1}{2})\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"\\boxed{-1799\\dfrac{1}{2}}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (4) 题</span>\n    <span class=\"mc-badge mc-berr\">错误</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"(-1)^{2023} + (-2)^3 \\times \\left(-\\dfrac{1}{2}\\right) - (-3^2) - |-1|\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-err\">学生答案：\\(-6\\dfrac{1}{2}\\)</div>\n    <div class=\"mc-en\">错因：\\(-(-3^2)\\) 应为 \\(+9\\)，学生算成了 \\(-9\\)</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 + (-8) \\times \\left(-\\dfrac{1}{2}\\right) - (-9) - 1\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -1 + 4 + 9 - 1\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"= 3 + 9 - 1 = \\boxed{11}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (5) 题</span>\n    <span class=\"mc-badge mc-berr\">错误</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"-2^2 - 8 \\div \\left(-\\dfrac{1}{2}\\right) \\times 2\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-err\">学生答案：36</div>\n    <div class=\"mc-en\">错因：\\(-2^2 = -4\\)，混淆了 \\(-2^2\\) 与 \\((-2)^2\\)</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -4 - 8 \\div \\left(-\\dfrac{1}{2}\\right) \\times 2\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -4 - (-16) \\times 2\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -4 + 32\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"\\boxed{28}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-na\">\n    <span>第 (6) 题</span>\n    <span class=\"mc-badge mc-bna\">未完成</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"\\left[\\left(-\\dfrac{3}{5}\\right) - \\dfrac{5}{3}\\right] \\div \\left[(-3)^2 + |2 - 3|\\right]\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-na\">学生答案：未完成</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= \\left[-\\dfrac{9}{15} - \\dfrac{25}{15}\\right] \\div \\left[9 + 1\\right]\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= \\left(-\\dfrac{34}{15}\\right) \\div 10\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -\\dfrac{34}{15} \\times \\dfrac{1}{10}\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"= -\\dfrac{34}{150} = \\boxed{-\\dfrac{17}{75}}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (7) 题</span>\n    <span class=\"mc-badge mc-berr\">错误</span>\n  </div>\n  <div class=\"mc-pbody\">\n    <div class=\"mc-orig\"><span class=\"math-block\" data-latex=\"-24 \\times \\left(\\dfrac{1}{3} - \\dfrac{3}{4} + \\dfrac{1}{6} - \\dfrac{5}{8}\\right)\" contenteditable=\"false\"></span></div>\n    <div class=\"mc-sa mc-sa-err\">学生答案：\\(-21\\)</div>\n    <div class=\"mc-en\">错因：分配律展开时漏掉了 \\(-24\\) 的负号，正负号全反</div>\n    <div class=\"mc-steps\">\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= -8 + 18 - 4 + 15\" contenteditable=\"false\"></span></div>\n      <div class=\"mc-line\"><span class=\"math-block\" data-latex=\"= 10 - 4 + 15\" contenteditable=\"false\"></span></div>\n    </div>\n    <div class=\"mc-fr\"><span class=\"math-block\" data-latex=\"= 6 + 15 = \\boxed{21}\" contenteditable=\"false\"></span></div>\n  </div>\n</div>\n\n<div class=\"mc-problem\">\n  <div class=\"mc-ph mc-err\">\n    <span>第 (8) 